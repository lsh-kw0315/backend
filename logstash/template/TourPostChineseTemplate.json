{
  "index_patterns": ["tourpostchs"],
  "template": {
    "settings": {
      "index" : {
        "indexing.slowlog.threshold.index.warn": "0ms",
        "indexing.slowlog.threshold.index.info": "0ms",
        "indexing.slowlog.threshold.index.debug": "0ms",
        "indexing.slowlog.threshold.index.trace": "0ms",

        "search.slowlog.threshold.query.warn": "0ms",
        "search.slowlog.threshold.query.info": "0ms",
        "search.slowlog.threshold.query.debug": "0ms",
        "search.slowlog.threshold.query.trace": "0ms",
        "max_ngram_diff": 10
      },
      "analysis": {
        "char_filter": {
          "remove_korean": {
            "type": "pattern_replace",
            "pattern": "[ㄱ-ㅎ가-힣]",
            "replacement": ""
          },
          "remove_symbols": {
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s]",
            "replacement": ""
          }
        },
        "analyzer": {
          "chs_content_search_analyzer": {
            "type": "custom",
            "tokenizer": "ik_smart",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "cjk_width",
              "content_pinyin",
              "asciifolding"
            ]
          },
          "chs_word_search_analyzer": {
            "type": "custom",
            "tokenizer": "ik_smart",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
                "cjk_width",
                "ngram_filter",
                "word_pinyin",
                "asciifolding",
                "unique"
            ]
          },
          "chs_word_analyzer": {
            "type": "custom",
            "tokenizer": "ik_smart",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "cjk_width",
              "my_pinyin",
              "asciifolding"
            ]
          }
        },
        "filter": {
          "ngram_filter": {
            "type": "ngram",
            "min_gram": 1,
            "max_gram": 3
          },
          "my_pinyin": {
            "type": "pinyin",
            "keep_first_letter": false,
            "keep_separate_first_letter": false,
            "keep_full_pinyin": true,
            "keep_original": false,
            "keep_joined_full_pinyin": false,
            "limit_first_letter_length": 0,
            "lowercase": true
          },
          "word_pinyin": {
            "type": "pinyin",
            "keep_first_letter": false,
            "keep_separate_first_letter": false,
            "keep_full_pinyin": true,
            "keep_original": false,
            "keep_joined_full_pinyin": true,
            "limit_first_letter_length": 0,
            "lowercase": true
          },
          "content_pinyin": {
            "type": "pinyin",
            "keep_first_letter": false,
            "keep_separate_first_letter": false,
            "keep_full_pinyin": true,
            "keep_original": false,
            "keep_joined_full_pinyin": true,
            "limit_first_letter_length": 0,
            "lowercase": true
          },
          "han_to_latin": {
            "type": "icu_transform",
            "id": "Han-Latin"
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "content_id": {
          "type": "long"
        },
        "common_place_id": {
          "type": "long"
        },
        "first_image":{
          "type": "keyword"
        },
        "addr1": {
          "type": "keyword"
        },
        "title": {
          "type": "text",
          "analyzer": "chs_word_analyzer",
          "fields": {
            "ngram": {
              "type": "text",
              "analyzer": "chs_word_search_analyzer"
            }
          }
        },
        "overview": {
          "type": "text",
          "analyzer": "chs_content_search_analyzer"
        },
        "location": {
          "type": "geo_point"
        },
        "create_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "cat1": {
          "type": "keyword"
        },
        "cat2": {
          "type": "keyword"
        },
        "cat3": {
          "type": "keyword"
        },
        "content_type_id": {
          "type": "long"
        },
        "area_code": {
          "type": "long"
        },
        "review_count": {
          "type": "long"
        },
        "rating_average": {
          "type": "scaled_float",
          "scaling_factor": 10
        },
        "language": {
          "type": "keyword"
        }
      }
    }
  }
}
