{
  "index_patterns": [
    "commpostkor"
  ],
  "template": {
    "settings": {
      "index" : {
        "indexing.slowlog.threshold.index.warn": "0ms",
        "indexing.slowlog.threshold.index.info": "0ms",
        "indexing.slowlog.threshold.index.debug": "0ms",
        "indexing.slowlog.threshold.index.trace": "0ms",

        "search.slowlog.threshold.query.warn": "0ms",
        "search.slowlog.threshold.query.info": "0ms",
        "search.slowlog.threshold.query.debug": "0ms",
        "search.slowlog.threshold.query.trace": "0ms",
        "max_ngram_diff": 10
      },
      "analysis": {
        "char_filter": {
          "remove_symbols": {
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s\\d]",
            "replacement": ""
          }
        },
        "tokenizer": {
          "nori_mixed": {
            "type": "nori_tokenizer",
            "decompound_mode": "mixed"
          },
          "nori_none": {
            "type": "nori_tokenizer",
            "decompound_mode": "none"
          },
          "fixed_length_tokenizer": {
            "type": "pattern",
            "pattern": ".{1,2}",
            "group": 0
          }
        },
        "analyzer": {
          "korean_mixed": {
            "type": "custom",
            "tokenizer": "nori_mixed",
            "filter": [
              "nori_readingform",
              "nori_part_of_speech"
            ]
          },
          "partial_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "asciifolding",
              "my_word_delimiter_graph",
              "ngram_filter",
              "unique"
            ]
          },
          "normalized_analyzer": {
            "type": "custom",
            "tokenizer": "fixed_length_tokenizer",
            "char_filter": [
              "remove_symbols"
            ],
            "filter": [
              "lowercase",
              "asciifolding"
            ]
          },
          "original_analyzer": {
            "type": "custom",
            "tokenizer": "fixed_length_tokenizer",
            "filter": [
              "lowercase",
              "asciifolding"
            ]
          }
        },
        "filter": {
          "ngram_filter": {
            "type": "ngram",
            "min_gram": 2,
            "max_gram": 8
          },
          "nori_stoptags": {
            "type": "nori_part_of_speech",
            "stoptags": ["SP"]
          },
          "my_word_delimiter_graph": {
            "type": "word_delimiter_graph",
            "preserve_original": true
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "long"
        },
        "member_id": {
          "type": "long"
        },
        "content": {
          "type": "text",
          "analyzer": "korean_mixed"
        },
        "create_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "modify_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "location": {
          "type": "geo_point"
        },
        "nickname":{
          "type": "text",
          "analyzer": "original_analyzer",
          "fields": {
            "ngram": {
              "type": "text",
              "analyzer": "partial_analyzer"
            },
            "normalized": {
              "type": "text",
              "analyzer": "normalized_analyzer"
            }
          }
        },
        "comment_count": {
          "type": "long"
        },
        "like_count": {
          "type": "long"
        },
        "language": {
          "type": "keyword"
        },
        "image_urls": {
          "type": "keyword"
        }
      }
    }
  }
}
