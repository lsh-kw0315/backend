{
  "index_patterns": [
    "commpostjpn"
  ],
  "template": {
    "settings": {
      "index" : {
        "indexing.slowlog.threshold.index.warn": "0ms",
        "indexing.slowlog.threshold.index.info": "0ms",
        "indexing.slowlog.threshold.index.debug": "0ms",
        "indexing.slowlog.threshold.index.trace": "0ms",

        "search.slowlog.threshold.query.warn": "0ms",
        "search.slowlog.threshold.query.info": "0ms",
        "search.slowlog.threshold.query.debug": "0ms",
        "search.slowlog.threshold.query.trace": "0ms",
        "max_ngram_diff": 10
      },
      "analysis": {
        "char_filter": {
          "remove_korean": {
            "type": "pattern_replace",
            "pattern": "[ㄱ-ㅎ가-힣]",
            "replacement": ""
          },
          "remove_symbols":{
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s\\d]",
            "replacement": ""
          }
        },
        "tokenizer": {
          "kuromoji_search_tokenizer": {
            "type": "kuromoji_tokenizer",
            "mode": "search",
            "user_dictionary": "userdict_ja.txt",
            "discard_compound_token": false
          },
          "kuromoji_word_tokenizer": {
            "type": "kuromoji_tokenizer",
            "mode": "search",
            "discard_compound_token": false
          },
          "fixed_length_tokenizer": {
            "type": "pattern",
            "pattern": ".{1,2}",
            "group": 0
          }
        },
        "analyzer": {
          "japanese_content_romaji_search": {
            "type": "custom",
            "tokenizer": "kuromoji_search_tokenizer",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "cjk_width",
              "kuromoji_baseform",
              "ja_stop",
              "kuromoji_part_of_speech",
              "kuromoji_number",
              "kuromoji_stemmer",
              "katakana_filter",
              "katakana_to_latin",
              "post_symbols_filter",
              "asciifolding",
              "lowercase"
            ]
          },
          "partial_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "asciifolding",
              "my_word_delimiter_graph",
              "ngram_filter",
              "unique"
            ]
          },
          "normalized_analyzer": {
            "type": "custom",
            "tokenizer": "fixed_length_tokenizer",
            "char_filter": [
              "remove_symbols"
            ],
            "filter": [
              "lowercase",
              "asciifolding"
            ]
          },
          "original_analyzer": {
            "type": "custom",
            "tokenizer": "fixed_length_tokenizer",
            "filter": [
              "lowercase",
              "asciifolding"
            ]
          }
        },
        "filter": {
          "ngram_filter": {
            "type": "ngram",
            "min_gram": 2,
            "max_gram": 8
          },
          "romaji_filter": {
            "type": "kuromoji_readingform",
            "use_romaji": true
          },
          "katakana_filter": {
            "type": "kuromoji_readingform",
            "use_romaji": false
          }
        ,
          "katakana_to_latin": {
            "type": "icu_transform",
            "id": "Katakana-Latin"
          },
          "kuromoji_stoptags": {
            "type": "kuromoji_part_of_speech",
            "stoptags": ["記号"]
          },
          "post_symbols_filter": {
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s]",
            "replacement": ""
          },
          "my_word_delimiter_graph": {
            "type": "word_delimiter_graph",
            "preserve_original": true
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "long"
        },
        "member_id": {
          "type": "long"
        },
        "content": {
          "type": "text",
          "analyzer": "japanese_content_romaji_search"
        },
        "create_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "modify_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "location": {
          "type": "geo_point"
        },
        "nickname":{
          "type": "text",
          "analyzer": "original_analyzer",
          "fields": {
            "ngram": {
              "type": "text",
              "analyzer": "partial_analyzer"
            },
            "normalized": {
              "type": "text",
              "analyzer": "normalized_analyzer"
            }
          }
        },
        "comment_count": {
          "type": "long"
        },
        "like_count": {
          "type": "long"
        },
        "language": {
          "type": "keyword"
        },
        "image_urls": {
          "type": "keyword"
        }
      }
    }
  }
}
