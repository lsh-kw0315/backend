{
  "index_patterns": [
    "tourposteng"
  ],
  "template": {
    "settings": {
      "index": {
        "indexing.slowlog.threshold.index.warn": "0ms",
        "indexing.slowlog.threshold.index.info": "0ms",
        "indexing.slowlog.threshold.index.debug": "0ms",
        "indexing.slowlog.threshold.index.trace": "0ms",

        "search.slowlog.threshold.query.warn": "0ms",
        "search.slowlog.threshold.query.info": "0ms",
        "search.slowlog.threshold.query.debug": "0ms",
        "search.slowlog.threshold.query.trace": "0ms",
        "max_ngram_diff": 10
      },
      "analysis": {
        "tokenizer": {
          "fixed_length_tokenizer": {
            "type": "pattern",
            "pattern": ".{1,3}",
            "group": 0
          }
        },
        "char_filter": {
          "remove_korean": {
            "type": "pattern_replace",
            "pattern": "[ㄱ-ㅎ가-힣]",
            "replacement": ""
          },
          "remove_symbols": {
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s]",
            "replacement": ""
          }
        },
        "analyzer": {
          "english_content_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "lowercase",
              "stop",
              "porter_stem",
              "asciifolding",
              "word_delimiter_graph"
            ]
          },
          "english_word_analyzer": {
            "type": "custom",
            "tokenizer": "keyword",
            "char_filter": [
              "remove_korean",
              "remove_symbols"
            ],
            "filter": [
              "lowercase",
              "asciifolding",
              "my_word_delimiter_graph",
              "ngram_filter",
              "unique"
            ]
          },
          "normal_analyzer": {
            "type": "custom",
            "tokenizer": "standard",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "lowercase",
              "asciifolding",
              "fixed_length_filter"
            ]
          }
        },
        "filter": {
          "ngram_filter": {
            "type": "ngram",
            "min_gram": 3,
            "max_gram": 8
          },
          "my_word_delimiter_graph": {
            "type": "word_delimiter_graph",
            "preserve_original": true
          },
          "fixed_length_filter": {
            "type": "pattern_capture",
            "patterns": ["(.{1,3})"],
            "preserve_original": false
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "content_id": {
          "type": "long"
        },
        "common_place_id": {
          "type": "keyword"
        },
        "addr1": {
          "type": "keyword"
        },
        "title": {
          "type": "text",
          "analyzer": "normal_analyzer",
          "fields": {
            "ngram": {
              "type": "text",
              "analyzer": "english_word_analyzer"
            }
          }
        },
        "overview": {
          "type": "text",
          "analyzer": "english_content_analyzer"
        },
        "location": {
          "type": "geo_point"
        },
        "create_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "cat1": {
          "type": "keyword"
        },
        "cat2": {
          "type": "keyword"
        },
        "cat3": {
          "type": "keyword"
        },
        "content_type_id": {
          "type": "long"
        },
        "area_code": {
          "type": "long"
        },
        "first_image": {
          "type": "keyword"
        },
        "review_count": {
          "type": "long"
        },
        "rating_average": {
          "type": "scaled_float",
          "scaling_factor": 10
        },
        "language": {
          "type": "keyword"
        }
      }
    }
  }
}