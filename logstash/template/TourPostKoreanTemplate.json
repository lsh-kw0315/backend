{
  "index_patterns": ["tourpostkor"],
  "template": {
    "settings": {
      "index" : {
        "indexing.slowlog.threshold.index.warn": "0ms",
        "indexing.slowlog.threshold.index.info": "0ms",
        "indexing.slowlog.threshold.index.debug": "0ms",
        "indexing.slowlog.threshold.index.trace": "0ms",

        "search.slowlog.threshold.query.warn": "0ms",
        "search.slowlog.threshold.query.info": "0ms",
        "search.slowlog.threshold.query.debug": "0ms",
        "search.slowlog.threshold.query.trace": "0ms",
        "max_ngram_diff": 10
      },
      "analysis": {
        "char_filter": {
          "remove_symbols": {
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s]",
            "replacement": ""
          }
        },
        "tokenizer": {
          "nori_mixed": {
            "type": "nori_tokenizer",
            "decompound_mode": "mixed"
          },
          "nori_none": {
            "type": "nori_tokenizer",
            "decompound_mode": "none"
          },
          "fixed_length_tokenizer": {
            "type": "pattern",
            "pattern": ".{1,1}",
            "group": 0
          }
        },
        "analyzer": {
          "korean_mixed": {
            "type": "custom",
            "tokenizer": "nori_mixed",
            "filter": [
              "nori_readingform",
              "nori_part_of_speech"
            ]
          },
          "korean_word": {
            "char_filter": ["remove_symbols"],
            "type": "custom",
            "tokenizer": "fixed_length_tokenizer"
          },
          "korean_test": {
            "tokenizer": "nori_mixed",
            "type": "custom",
            "filter":[
              "nori_readingform",
              "nori_stoptags"
            ]
          },
          "korean_partial": {
            "type": "custom",
            "tokenizer": "keyword",
            "char_filter": [
              "remove_symbols"
            ],
            "filter": [
              "ngram_filter",
              "unique"
            ]
          }
        },
        "filter": {
          "ngram_filter":{
            "type": "ngram",
            "min_gram": 2,
            "max_gram": 5
          },
          "nori_stoptags": {
              "type": "nori_part_of_speech",
              "stoptags": ["SP"]
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "content_id": {
          "type": "long"
        },
        "common_place_id": {
          "type": "keyword"
        },
        "first_image":{
          "type": "keyword"
        },
        "addr1": {
          "type": "keyword"
        },
        "title": {
          "type": "text",
          "analyzer": "korean_word",
          "fields": {
            "ngram": {
              "type": "text",
              "analyzer": "korean_partial"
            },
            "test": {
              "type": "text",
              "analyzer": "korean_test"
            }
          }
        },
        "location": {
          "type": "geo_point"
        },
        "overview": {
          "type": "text",
          "analyzer": "korean_mixed"
        },
        "create_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "cat1": {
          "type": "keyword"
        },
        "cat2": {
          "type": "keyword"
        },
        "cat3": {
          "type": "keyword"
        },
        "content_type_id": {
          "type": "long"
        },
        "area_code": {
          "type": "long"
        },
        "review_count": {
          "type": "long"
        },
        "rating_average": {
          "type": "scaled_float",
          "scaling_factor": 10
        },
        "language": {
          "type": "keyword"
        }
      }
    }
  }
}
